# Auto-Media local server
PORT=8787

# Studio authentication. When enabled and Firebase Admin values are present, Studio routes require Firebase ID tokens.
STUDIO_AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PostgreSQL target for the new architecture
DATABASE_URL=postgresql://automedia:change-me@localhost:5432/automedia

# Optional n8n bridge. Set false when n8n is not installed.
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_TIMEOUT_MS=30000
N8N_WEBHOOK_PREFIX=webhook

# Existing Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Built-in AI engine (OpenAI-compatible endpoints)
# For a host service used from Docker on Windows, host.docker.internal can be used.
AI_BASE_URL=http://host.docker.internal:3001/v1
AI_API_KEY=
AI_TEXT_MODEL=auto
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=auto
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_TIMEOUT_MS=120000
AI_TEMPERATURE=0.7
AI_JSON_MODE=true

# Default RSS feeds used when an automation does not provide rssUrls
TECH_RSS_FEEDS=

# Generated media directory
MEDIA_ROOT=./media

# Public media URL base used by URL-fetching platforms
PUBLIC_BASE_URL=http://localhost:8787
CREDENTIALS_MASTER_KEY=

# Social OAuth provider apps (server-side only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/yt-analytics.readonly https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social r_member_postAnalytics r_member_profileAnalytics
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=user.info.basic user.info.stats video.publish
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,read_insights
META_GRAPH_VERSION=v26.0

# Threads/Pinterest OAuth
THREADS_OAUTH_APP_ID=
THREADS_OAUTH_APP_SECRET=
THREADS_OAUTH_SCOPES=threads_basic threads_content_publish
PINTEREST_OAUTH_APP_ID=
PINTEREST_OAUTH_APP_SECRET=
PINTEREST_OAUTH_SCOPES=boards:read boards:write pins:read pins:write

# Optional object storage (default: local). For MinIO/S3 use STORAGE_MODE=s3.
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=automedia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL=3600

# X OAuth 2.0 PKCE
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write

# Reddit OAuth2
REDDIT_OAUTH_CLIENT_ID=
REDDIT_OAUTH_CLIENT_SECRET=

# Studio data retention (minimums are enforced by the application)
RETENTION_METRICS_DAYS=180
RETENTION_EXECUTIONS_DAYS=180
RETENTION_JOBS_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_INVITATION_DAYS=30

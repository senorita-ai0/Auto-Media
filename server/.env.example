# Auto-Media local server
PORT=8787

# PostgreSQL target for the new architecture
DATABASE_URL=postgresql://automedia:change-me@localhost:5432/automedia

# Optional n8n bridge. Set false when n8n is not installed.
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=

# Existing Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Built-in AI engine (OpenAI-compatible endpoints)
# For a host service used from Docker on Windows, host.docker.internal can be used.
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=auto
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_TIMEOUT_MS=120000
AI_TEMPERATURE=0.7
AI_JSON_MODE=true

# Default RSS feeds used when an automation does not provide rssUrls
TECH_RSS_FEEDS=

# Generated media directory
MEDIA_ROOT=./media

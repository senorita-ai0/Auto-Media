# Auto-Media local server
PORT=8787

# PostgreSQL target for the new architecture
DATABASE_URL=postgresql://automedia:change-me@localhost:5432/automedia

# Optional n8n bridge. Set false when n8n is not installed.
N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=

# Existing Google Sheets integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

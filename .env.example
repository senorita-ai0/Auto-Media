# Auto-Media Docker environment
# Copy to .env before docker compose up.

# PostgreSQL
POSTGRES_DB=automedia
POSTGRES_USER=automedia
POSTGRES_PASSWORD=change-this-password

# Built-in AI (OpenAI-compatible)
# Your existing local FreeLLMAPI-style service can use this Docker hostname.
AI_BASE_URL=http://host.docker.internal:3001/v1
AI_API_KEY=
AI_TEXT_MODEL=auto
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=auto
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_TIMEOUT_MS=120000
AI_TEMPERATURE=0.7
AI_JSON_MODE=true

# Comma-separated fallback RSS feeds.
# Prefer putting feed URLs on each automation when different pages use different sources.
TECH_RSS_FEEDS=

# Optional n8n integration.
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_SHARED_SECRET=
N8N_API_KEY=
N8N_TIMEOUT_MS=30000
N8N_WEBHOOK_PREFIX=webhook

# Public base URL used by platforms that fetch media by URL
PUBLIC_BASE_URL=http://localhost:8787

# Studio authentication. Enable after configuring Firebase Admin service-account values below.
STUDIO_AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Master key used to encrypt stored social credentials. Use a long random secret in production.
CREDENTIALS_MASTER_KEY=

# Social OAuth provider apps (server-side only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.upload
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile w_member_social
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_SCOPES=user.info.basic video.publish
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
META_GRAPH_VERSION=v26.0

# Threads/Pinterest OAuth
THREADS_OAUTH_APP_ID=
THREADS_OAUTH_APP_SECRET=
THREADS_OAUTH_SCOPES=threads_basic threads_content_publish
PINTEREST_OAUTH_APP_ID=
PINTEREST_OAUTH_APP_SECRET=
PINTEREST_OAUTH_SCOPES=boards:read boards:write pins:read pins:write

# Optional scheduled PostgreSQL backups (enable with: docker compose --profile backup up -d)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSWORD=

# Optional object storage (default: local). For MinIO/S3 use STORAGE_MODE=s3.
STORAGE_MODE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=automedia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL=3600
